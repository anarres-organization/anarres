diff --git a/nequix/data.py b/nequix/data.py
--- a/nequix/data.py
+++ b/nequix/data.py
@@ -257,9 +257,15 @@ class DataLoader:
         if self._started:
             return
 
-        # NB: we can use fork here, only because we are not using jax
-        # in the workers (data is just numpy arrays)
-        # multiprocessing.set_start_method("spawn", force=True)
+        # Avoid inheriting an open LMDB handle. Each worker reopens it lazily.
+        dataset = self.dataset
+        while hasattr(dataset, "base"):
+            dataset = dataset.base
+        for database in getattr(dataset, "dbs", []):
+            if getattr(database, "_env", None) is not None:
+                database._env.close()
+                database._env = None
+        # Fork is safe here because workers only construct NumPy graph records.
         self._started = True
         self.index_queue = multiprocessing.Queue()
         self.output_queue = multiprocessing.Queue()
