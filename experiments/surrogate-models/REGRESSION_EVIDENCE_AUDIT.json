{
  "artifact": "anarres_regression_evidence_audit_v1",
  "decision": {
    "fit_shared_localized_model": false,
    "next": "freeze a new independent intervention using one native localized endpoint, score the existing domain model and a measurement-only baseline, and retain the starting-policy option before testing shared representations",
    "why": [
      "the positive localized results are retrospective and nested within one intervention",
      "both prospective localized tests failed",
      "relative candidate harm is useful but is not a localized regression label",
      "pooling rows would turn nested tasks, materials, or strata into false sample size"
    ]
  },
  "endpoint_classes": {
    "candidate_relative_underperformance": "a whole candidate performs worse than a study-matched alternative",
    "localized_absolute_regression": "a task or target becomes worse than the common starting policy",
    "localized_change_ordering": "a pretraining risk score orders task or state changes after training"
  },
  "question": "Which released sources can support prediction of where a candidate training environment will cause regressions?",
  "rules": [
    "preserve each native regression definition and independent unit",
    "report discrimination and calibration when the endpoint is probabilistic",
    "hold out complete interventions before claiming transfer",
    "keep candidate-level relative harm separate from localized regression",
    "retain failed prospective tests as negative controls"
  ],
