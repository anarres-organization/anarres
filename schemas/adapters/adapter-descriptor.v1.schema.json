{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarres.dev/schemas/adapters/adapter-descriptor.v1.schema.json",
  "title": "Anarres adapter descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "protocol_version",
    "domain",
    "executable",
    "profile_schema_versions",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "anarres.adapter-descriptor.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "const": 2
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "pattern": "^anarres-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "measurement_contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  }
}
