{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarres.science/schemas/environments/probe-run.v1.schema.json",
  "title": "Anarres probe-run metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "policy_id",
    "policy_revision",
    "source_license",
    "source_revision",
    "source_uri",
    "probe_contract"
  ],
  "properties": {
    "schema_version": {"const": "anarres.probe-run.v1"},
    "environment_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "source_license": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "probe_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_size", "temperature", "max_new_tokens", "advantage_estimator"],
      "properties": {
        "group_size": {"type": "integer", "minimum": 2},
        "temperature": {"type": "number", "minimum": 0},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "advantage_estimator": {"const": "leave-one-out-unnormalized"}
      }
    }
  }
}
