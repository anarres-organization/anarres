{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarres.science/schemas/robotics/policy-runner-result.v1.schema.json",
  "title": "Anarres robotics policy-runner result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "runner", "artifacts"],
  "properties": {
    "schema_version": {"const": "anarres.robotics-policy-runner-result.v1"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "sha256"],
        "properties": {
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
